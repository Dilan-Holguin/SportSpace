DB_USER=sportspace
DB_PASSWORD=sportspace
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sportspace
DATABASE_URL=postgresql://sportspace:sportspace@localhost:5432/sportspace?schema=public
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
ADMIN_EMAIL=admin@udea.edu.co
ADMIN_PASSWORD=Admin1234
ADMIN_NAME=SportSpace Admin

# --- Public demo: use Render (render.yaml), not Vercel. VPS alternative below. ---
